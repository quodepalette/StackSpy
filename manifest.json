{
  "manifest_version": 3,
  "name": "JoErl StackSpy",
  "version": "2.2.0",
  "description": "X-ray any website: detect its technologies, versions, headers, CSS techniques and performance — with plain-English explanations that teach you how it was built.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "webRequest", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JoErl StackSpy",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
